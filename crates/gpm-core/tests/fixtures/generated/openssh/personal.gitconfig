[user]
	name = Juan
	email = juan@personal.dev
	signingkey = ~/.ssh/id_ed25519_personal.pub
[core]
	sshCommand = SSH_AUTH_SOCK='\\\\.\\pipe\\openssh-ssh-agent' C:/Windows/System32/OpenSSH/ssh.exe -i ~/.ssh/id_ed25519_personal -o IdentitiesOnly=yes
[credential "https://github.com"]
	username = juan-personal
[gpg]
	format = ssh
[gpg "ssh"]
	program = C:/Users/juan/.gitprofiles/ssh-keygen.cmd
	allowedSignersFile = ~/.gitprofiles/allowed_signers
[commit]
	gpgsign = true
