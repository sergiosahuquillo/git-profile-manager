# Profile: Personal
[user]
	name = Juan
	email = juan@personal.dev
	signingkey = ~/.ssh/id_ed25519_personal.pub
[core]
	sshCommand = \"C:/Program Files/Git/usr/bin/ssh.exe\" -i ~/.ssh/id_ed25519_personal -o IdentitiesOnly=yes
[credential "https://github.com"]
	username = juan-personal
[gpg]
	format = ssh
[gpg "ssh"]
	program = C:/Program Files/Git/usr/bin/ssh-keygen.exe
	allowedSignersFile = ~/.gitprofiles/allowed_signers
[commit]
	gpgsign = true
