# Generated by GitProfile Manager. Do not edit by hand.
# Strict mode: a repo with no matching rule can't commit.
[user]
	useConfigOnly = true

# Rules: evaluated afterwards, they override the default profile.
[includeIf "gitdir/i:C:/dev/empresa-a/"]
	path = trabajo.gitconfig
[includeIf "gitdir/i:~/clientes/b/"]
	path = cliente-b.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:empresa-a/**"]
	path = trabajo.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/empresa-a/**"]
	path = trabajo.gitconfig
[includeIf "hasconfig:remote.*.url:git@gitlab.corp.local:grupo/sub/**"]
	path = trabajo.gitconfig
[includeIf "hasconfig:remote.*.url:https://gitlab.corp.local/grupo/sub/**"]
