{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitProfile Manager",
  "version": "1.1.0",
  "identifier": "dev.ssahuquillo.gitprofilemanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GitProfile Manager",
        "width": 1366,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sergio Sahuquillo",
    "shortDescription": "Identidades Git por repositorio",
    "longDescription": "Gestiona varias identidades Git (nombre, email, clave SSH, cuenta HTTPS y firma) y hace que Git aplique la correcta en cada repositorio.",
    "category": "DeveloperTool",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRkVBOTEzRjE2QzhCOEQKUldTTmkyenhFNm4rM055YXVOV1l6WWFJMTczTWVocTNZMDc5N3hDWFlaUkowZzFWYm9zYzUxcFoK",
      "endpoints": ["https://github.com/sergiosahuquillo/git-profile-manager/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
